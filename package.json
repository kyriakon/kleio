{
  "name": "kleio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun ./scripts/dev.ts",
    "build": "bun tsc --noEmit && bun ./scripts/copy-public.ts && bun x tailwindcss -c tailwind.config.cjs -i src/styles.css -o dist/main.css --minify && bun build --outdir dist src/main.tsx",
    "preview": "bun ./scripts/preview.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tailwindcss": "^3.4.19",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.25",
    "typescript": "~6.0.3"
  }
}
